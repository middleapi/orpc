{
  "name": "@orpc/nest-playground",
  "type": "module",
  "version": "2.0.0-beta.32",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --exec \"node --import @swc-node/register/esm-register\"",
    "build": "nest build",
    "start": "node --import @swc-node/register/esm-register dist/main.js",
    "type:check": "tsc --noEmit",
    "jaeger": "docker run -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@orpc/client": "beta",
    "@orpc/contract": "beta",
    "@orpc/json-schema": "beta",
    "@orpc/nest": "beta",
    "@orpc/openapi": "beta",
    "@orpc/opentelemetry": "beta",
    "@orpc/publisher": "beta",
    "@orpc/server": "beta",
    "@orpc/tanstack-query": "beta",
    "@orpc/zod": "beta",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@tanstack/react-query": "^5.101.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  }
