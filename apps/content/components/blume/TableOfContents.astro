---
import type { Heading } from "blume/core/types.ts";
import BlumeTableOfContents from "blume/components/layout/TableOfContents.astro";
import CoffeeCard from "../../sponsors/CoffeeCard.astro";

interface Props {
  /** Headings to list (already filtered to the depths shown in the TOC). */
  headings: Heading[];
  /** Localized "On this page" heading. */
  title: string;
  /**
   * `mobile` renders the collapsible `<details>` shown above content on narrow
   * viewports; `desktop` renders the sticky aside list shown on wide ones.
   */
  variant: "mobile" | "desktop";
}

const { headings, title, variant } = Astro.props;
---

{
  // Only the desktop rail is customized; the mobile dropdown is Blume's own.
  // The layout's children (the mount the page actions move into below `xl`)
  // are passed through only when given, since Blume renders the dropdown for
  // them even on a page without headings.
  variant === "mobile" &&
    (Astro.slots.has("default") ? (
      <BlumeTableOfContents headings={headings} title={title} variant="mobile">
        <slot />
      </BlumeTableOfContents>
    ) : (
      <BlumeTableOfContents headings={headings} title={title} variant="mobile" />
    ))
}
{
  headings.length > 0 && variant === "desktop" && (
    <>
      <p class="mb-3 font-semibold text-muted-foreground text-xs uppercase tracking-[0.05em]">
        {title}
      </p>
      <blume-toc class="block">
        <ul class="m-0 list-none p-0">
          {headings.map((heading) => (
            <li
              data-depth={heading.depth}
              style={`padding-inline-start:${(heading.depth - 2) * 0.875}rem`}
            >
              <a
                class="block py-1 text-muted-foreground transition-colors hover:text-foreground aria-[current=location]:text-accent"
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </blume-toc>
      <CoffeeCard />
    </>
  )
}
