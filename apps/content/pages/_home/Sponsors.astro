---
// Sponsor wall, rendered at build time from sponsors/sponsors.ts (generated by
// scripts/sync-sponsors.ts, the same source the README tables come from).
import Icon from 'blume/components/Icon.astro'
import { relAttribute } from '../../sponsors/ads'
import { pastSponsors, sponsorTiers } from '../../sponsors/data'

const GITHUB_SPONSOR_URL = 'https://github.com/sponsors/dinwwwh'
const OPEN_COLLECTIVE_URL = 'https://opencollective.com/middleapi'
const PAST_SPONSORS_URL = 'https://htmlpreview.github.io/?https://github.com/middleapi/static/blob/main/sponsors.svg'

const tiers = sponsorTiers()

// The top tiers get a named card each (the first one double-width, so rank reads
// at a glance); everything below joins the avatar wall, where a larger avatar
// still marks the higher tier.
const highlights = tiers
  .filter(tier => tier.level >= 3)
  .flatMap(tier => tier.sponsors.map(sponsor => ({ ...sponsor, tier: tier.title })))

const wall = tiers.filter(tier => tier.level < 3).flatMap(tier => tier.sponsors)

const past = pastSponsors()
---

{
  tiers.length > 0 && (
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase">
              Sponsors
            </p>
            <h2 class="font-display mt-4 max-w-2xl text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
              Paid for by the people who build on it.
            </h2>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
              oRPC is MIT licensed and developed in the open. Sponsorship is what buys the time
              that goes into it.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-2 self-start sm:self-auto">
            <a class="orpc-btn orpc-btn-ghost" href={GITHUB_SPONSOR_URL} rel="noopener" target="_blank">
              <Icon name="heart" size={15} />
              GitHub Sponsors
            </a>
            <a class="orpc-btn orpc-btn-ghost" href={OPEN_COLLECTIVE_URL} rel="noopener" target="_blank">
              <Icon name="hand-coins" size={15} />
              Open Collective
            </a>
          </div>
        </div>

        {highlights.length > 0 && (
          <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {highlights.map((sponsor, index) => (
              <li class:list={[index === 0 && 'sm:col-span-2']}>
                <a
                  class="flex h-full items-center gap-4 rounded-blume border border-border p-4 transition-colors hover:bg-muted"
                  href={sponsor.link}
                  rel={relAttribute(sponsor.rel)}
                  target="_blank"
                >
                  <img
                    alt=""
                    class="size-12 flex-none rounded-blume object-cover"
                    data-no-zoom
                    height="48"
                    loading="lazy"
                    src={sponsor.avatar}
                    width="48"
                  />
                  <span class="min-w-0">
                    <span class="font-display block truncate text-sm font-semibold tracking-tight">
                      {sponsor.name}
                    </span>
                    <span class="mt-1 block truncate text-xs text-muted-foreground">
                      {sponsor.tier}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {wall.length > 0 && (
          <div class="mt-3 rounded-blume border border-border p-6">
            <p
              class="font-mono text-[0.6875rem] tracking-[0.18em] text-muted-foreground uppercase"
              id="sponsor-wall"
            >
              Sponsors and backers
            </p>
            <ul aria-labelledby="sponsor-wall" class="mt-5 flex flex-wrap items-center gap-2">
              {wall.map(sponsor => (
                <li>
                  {/* The name is the link's accessible name and its hover tooltip;
                      the avatar itself carries nothing extra to announce. */}
                  <a
                    aria-label={sponsor.name}
                    href={sponsor.link}
                    rel={relAttribute(sponsor.rel)}
                    target="_blank"
                    title={sponsor.name}
                  >
                    <img
                      alt=""
                      class:list={[
                        'rounded-full object-cover ring-1 ring-border transition hover:ring-foreground/40',
                        sponsor.tierLevel >= 2 ? 'size-12' : 'size-10',
                      ]}
                      data-no-zoom
                      height={sponsor.tierLevel >= 2 ? 48 : 40}
                      loading="lazy"
                      src={sponsor.avatar}
                      width={sponsor.tierLevel >= 2 ? 48 : 40}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {past.length > 0 && (
          <p class="mt-6 text-sm text-muted-foreground">
            With thanks to{' '}
            {/* The SVG wall lists everyone, current and past, in one place. */}
            <a
              class="underline underline-offset-4 transition-colors hover:text-foreground"
              href={PAST_SPONSORS_URL}
              rel="noopener"
              target="_blank"
            >
              {past.length} past sponsors
            </a>{' '}
            who helped get oRPC here.
          </p>
        )}
      </div>
    </section>
  )
}
