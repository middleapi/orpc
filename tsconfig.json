{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",

    "types": ["node", "vitest/globals"],

    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "*",
    "scripts",
    "benches",
    "tests",
    "*/*/*",
    "*/*/tests",
    "*/*/benches",
    "*/*/src/**/*.test.ts",
    "*/*/src/**/*.test.tsx",
    "*/*/src/**/*.test-d.ts",
    "*/*/src/**/__tests__"
  ],
  "exclude": ["packages/bun/**", "packages/cloudflare/**", "packages/nest/**", "playgrounds/**"]
}
