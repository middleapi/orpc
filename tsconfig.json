{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2023"],
    "module": "nodenext",

    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],

    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "*",
    "scripts",
    "benches",
    "tests",
    "*/*/*",
    "*/*/tests",
    "*/*/src/**/__tests__",
    "*/*/src/**/*.test.ts",
    "*/*/src/**/*.test.tsx",
    "*/*/src/**/*.test-d.ts"
  ],
  "exclude": [
    "apps/**",
    "packages/bun/**",
    "packages/cloudflare/**",
    "packages/nest/**",
    "playgrounds/**"
  ]
}
