{
  "name": "@orpc/trpc",
  "version": "2.0.0-beta.48",
  "description": "tRPC interop for oRPC: reuse existing tRPC routers with oRPC clients and OpenAPI",
  "keywords": [
    "interop",
    "migration",
    "openapi",
    "orpc",
    "rpc",
    "trpc",
    "typesafe",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/trpc"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "dependencies": {
    "@orpc/contract": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "@orpc/openapi": "workspace:*",
    "@trpc/server": "^11.23.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@trpc/server": ">=11.4.2"
  }
}
