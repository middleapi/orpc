{
  "name": "@orpc/bun",
  "version": "2.0.0-beta.48",
  "description": "Bun integration for oRPC: Redis-backed pub/sub, rate limiting, and locking using Bun's built-in Redis client",
  "keywords": [
    "bun",
    "lock",
    "orpc",
    "pubsub",
    "ratelimit",
    "redis",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/bun"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "test": "bun --env-file=../../.env test",
    "test:coverage": "bun --env-file=../../.env test --coverage"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/experimental-lock": "workspace:*",
    "@orpc/publisher": "workspace:*",
    "@orpc/ratelimit": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-server/core": "~0.15.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "redis": "^6.3.1"
  }
}
