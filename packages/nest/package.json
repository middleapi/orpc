  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/nest"
  },
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      "./openapi": {
        "types": "./dist/openapi/index.d.mts",
        "import": "./dist/openapi/index.mjs",
        "default": "./dist/openapi/index.mjs"
      },
      "./rpc": {
        "types": "./dist/rpc/index.d.mts",
        "import": "./dist/rpc/index.mjs",
        "default": "./dist/rpc/index.mjs"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./openapi": "./src/openapi/index.ts",
    "./rpc": "./src/rpc/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "type:check": "tsc -b"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.1.27",
    "@nestjs/core": ">=11.1.27",
    "express": ">=5.2.1",
    "fastify": ">=5.8.5",
    "rxjs": ">=7.8.2"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
