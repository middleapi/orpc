{
  "name": "@orpc/nest",
  "version": "2.0.0-beta.48",
  "description": "NestJS integration for oRPC: implement typesafe contracts in NestJS controllers",
  "keywords": [
    "contract-first",
    "nest",
    "nestjs",
    "openapi",
    "orpc",
    "rpc",
    "typesafe",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/nest"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json && node ../../scripts/verify-dist.ts"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/openapi": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@oxc-project/runtime": "^0.155.0",
    "@standard-server/core": "~0.14.0",
    "@standard-server/node": "~0.14.0"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/platform-node": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.1.27",
    "@nestjs/core": ">=11.1.27",
    "@nestjs/platform-node": ">=12.3.0",
    "express": ">=5.2.1",
    "fastify": ">=5.8.5",
    "rxjs": ">=7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-node": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  }
}
