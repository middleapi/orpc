{
  "name": "@orpc/openapi",
  "type": "module",
  "version": "2.0.0-beta.48",
  "description": "Generate OpenAPI specs from oRPC routers and serve OpenAPI-compliant APIs with end-to-end type safety",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "homepage": "https://orpc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/openapi"
  },
  "keywords": [
    "orpc",
    "rpc",
    "api",
    "typescript",
    "typesafe",
    "openapi",
    "swagger",
    "scalar",
    "json-schema",
    "rest"
  ],
  "sideEffects": [
    "./dist/extensions/route.js"
  ],
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./helpers": {
        "types": "./dist/helpers/index.d.ts",
        "import": "./dist/helpers/index.js",
        "default": "./dist/helpers/index.js"
      },
      "./plugins": {
        "types": "./dist/plugins/index.d.ts",
        "import": "./dist/plugins/index.js",
        "default": "./dist/plugins/index.js"
      },
      "./standard": {
        "types": "./dist/adapters/standard/index.d.ts",
        "import": "./dist/adapters/standard/index.js",
        "default": "./dist/adapters/standard/index.js"
      },
      "./fetch": {
        "types": "./dist/adapters/fetch/index.d.ts",
        "import": "./dist/adapters/fetch/index.js",
        "default": "./dist/adapters/fetch/index.js"
      },
      "./node": {
        "types": "./dist/adapters/node/index.d.ts",
        "import": "./dist/adapters/node/index.js",
        "default": "./dist/adapters/node/index.js"
      },
      "./aws-lambda": {
        "types": "./dist/adapters/aws-lambda/index.d.ts",
        "import": "./dist/adapters/aws-lambda/index.js",
        "default": "./dist/adapters/aws-lambda/index.js"
      },
      "./fastify": {
        "types": "./dist/adapters/fastify/index.d.ts",
        "import": "./dist/adapters/fastify/index.js",
        "default": "./dist/adapters/fastify/index.js"
      },
      "./extensions/route": {
        "types": "./dist/extensions/route.d.ts",
        "import": "./dist/extensions/route.js",
        "default": "./dist/extensions/route.js"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./standard": "./src/adapters/standard/index.ts",
    "./fetch": "./src/adapters/fetch/index.ts",
    "./node": "./src/adapters/node/index.ts",
    "./aws-lambda": "./src/adapters/aws-lambda/index.ts",
    "./fastify": "./src/adapters/fastify/index.ts",
    "./extensions/route": "./src/extensions/route.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "peerDependencies": {
    "@scalar/api-reference": ">=1.57.2",
    "@types/swagger-ui": ">=5.32.0",
    "swagger-ui": ">=5.32.6"
  },
  "peerDependenciesMeta": {
    "@scalar/api-reference": {
      "optional": true
    },
    "@types/swagger-ui": {
      "optional": true
    },
    "swagger-ui": {
      "optional": true
    }
  },
  "dependencies": {
    "@openapi-spec/downgrader": "~0.6.0",
    "@openapi-spec/router": "~0.6.0",
    "@openapi-spec/types": "~0.6.0",
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/json-schema": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-server/core": "~0.14.0",
    "@standard-server/fetch": "~0.14.0"
  },
  "devDependencies": {
    "@scalar/api-reference": "^1.76.4",
    "@standard-server/aws-lambda": "~0.14.0",
    "@types/swagger-ui": "^5.32.1",
    "fastify": "^5.12.8",
    "swagger-ui": "^5.34.1",
    "zod": "^4.6.7"
  }
}
