{
  "name": "@orpc/valibot",
  "version": "2.0.0-beta.49",
  "description": "Valibot integration for oRPC: convert Valibot schemas into JSON Schema for OpenAPI generation",
  "keywords": [
    "json-schema",
    "openapi",
    "orpc",
    "typesafe",
    "typescript",
    "valibot",
    "validation"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/valibot"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsdown"
  },
  "dependencies": {
    "@orpc/json-schema": "workspace:*",
    "@valibot/to-json-schema": "^1.8.0"
  },
  "devDependencies": {
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "valibot": ">=1.5.0"
  }
}
