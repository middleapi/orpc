{
  "name": "@orpc/tanstack-query",
  "version": "2.0.0-beta.48",
  "description": "TanStack Query integration for oRPC: typesafe queries, mutations, streaming, and SSR for React, Vue, Solid, Svelte, and Angular",
  "keywords": [
    "angular-query",
    "mutation",
    "orpc",
    "query",
    "react-query",
    "solid-query",
    "ssr",
    "svelte-query",
    "tanstack-query",
    "typesafe",
    "typescript",
    "vue-query"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/tanstack-query"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/openapi": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "@tanstack/angular-query-experimental": "^5.105.3",
    "@tanstack/query-core": "^5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/solid-query": "^5.105.3",
    "@tanstack/svelte-query": "^6.3.9",
    "@tanstack/vue-query": "^5.105.3",
    "svelte": "^5.57.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.89.0"
  }
}
