{
  "name": "@orpc/zod",
  "version": "2.0.0-beta.48",
  "description": "Zod integration for oRPC: convert Zod schemas into JSON Schema for OpenAPI generation",
  "keywords": [
    "json-schema",
    "openapi",
    "orpc",
    "typesafe",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/zod"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "dependencies": {
    "@openapi-spec/types": "~0.6.0",
    "@orpc/json-schema": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": ">=4.5.0"
  }
}
