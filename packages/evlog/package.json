{
  "name": "@orpc/evlog",
  "type": "module",
  "version": "2.0.0-beta.48",
  "description": "Evlog integration for oRPC: wide-event logging for typesafe APIs",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "homepage": "https://orpc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/evlog"
  },
  "keywords": [
    "orpc",
    "evlog",
    "logging",
    "wide-events",
    "observability",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/adapters/node.d.ts",
        "import": "./dist/adapters/node.js",
        "default": "./dist/adapters/node.js"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./node": "./src/adapters/node.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc"
  },
  "peerDependencies": {
    "evlog": ">=2.18.1"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-server/core": "~0.14.0"
  },
  "devDependencies": {
    "evlog": "^2.34.0"
  }
}
