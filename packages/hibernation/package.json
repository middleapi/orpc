{
  "name": "@orpc/hibernation",
  "version": "2.0.0-beta.48",
  "description": "Hibernation API support for oRPC, including Cloudflare Durable Objects' WebSocket Hibernation",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "hibernation",
    "orpc",
    "typescript",
    "websocket"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/hibernation"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-server/core": "~0.15.0",
    "@standard-server/peer": "~0.15.0"
  }
}
