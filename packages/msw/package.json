{
  "name": "@orpc/msw",
  "version": "2.0.0-beta.48",
  "description": "MSW integration for oRPC: mock procedures at the network level with typed MSW request handlers",
  "keywords": [
    "mock-service-worker",
    "msw",
    "orpc"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/msw"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "@orpc/openapi": "workspace:*",
    "msw": "^3.0.3",
    "msw-v2": "npm:msw@^2.15.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "msw": ">=2.12.3"
  }
}
