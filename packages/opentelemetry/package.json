{
  "name": "@orpc/opentelemetry",
  "version": "2.0.0-beta.48",
  "description": "OpenTelemetry integration for oRPC: distributed tracing for typesafe APIs",
  "keywords": [
    "observability",
    "opentelemetry",
    "orpc",
    "otel",
    "tracing",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/opentelemetry"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  },
  "dependencies": {
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/instrumentation": ">=0.203.0"
  }
}
