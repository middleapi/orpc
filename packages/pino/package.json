{
  "name": "@orpc/pino",
  "version": "2.0.0-beta.49",
  "description": "Pino integration for oRPC: structured logging for typesafe APIs",
  "keywords": [
    "logger",
    "logging",
    "observability",
    "orpc",
    "pino",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/pino"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "prepack": "node ../../build.config.ts"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-server/core": "~0.15.0"
  },
  "devDependencies": {
    "pino": "^10.4.0"
  },
  "peerDependencies": {
    "pino": ">=10.1.0"
  }
}
