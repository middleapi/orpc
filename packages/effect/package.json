{
  "name": "@orpc/effect",
  "type": "module",
  "version": "2.0.0-beta.46",
  "description": "Effect integration for oRPC: build typesafe procedures with Effect",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "homepage": "https://orpc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/effect"
  },
  "keywords": [
    "orpc",
    "effect",
    "effect-ts",
    "rpc",
    "typescript",
    "typesafe"
  ],
  "sideEffects": [
    "./dist/extensions/effect.mjs",
    "./dist/extensions/schema.mjs"
  ],
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./extensions/effect": {
        "types": "./dist/extensions/effect.d.mts",
        "import": "./dist/extensions/effect.mjs",
        "default": "./dist/extensions/effect.mjs"
      },
      "./extensions/schema": {
        "types": "./dist/extensions/schema.d.mts",
        "import": "./dist/extensions/schema.mjs",
        "default": "./dist/extensions/schema.mjs"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./extensions/effect": "./src/extensions/effect.ts",
    "./extensions/schema": "./src/extensions/schema.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "unbuild",
    "type:check": "tsc -b"
  },
  "peerDependencies": {
    "effect": ">=4.0.0"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/json-schema": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "effect": "^4.0.5"
  }
}
