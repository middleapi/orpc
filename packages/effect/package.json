{
  "name": "@orpc/effect",
  "version": "2.0.0-beta.48",
  "description": "Effect integration for oRPC: build typesafe procedures with Effect",
  "keywords": [
    "effect",
    "effect-ts",
    "orpc",
    "rpc",
    "typesafe",
    "typescript"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/effect"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/extensions/effect.js",
    "./dist/extensions/schema.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./extensions/effect": "./src/extensions/effect.ts",
    "./extensions/schema": "./src/extensions/schema.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./extensions/effect": {
        "types": "./dist/extensions/effect.d.ts",
        "import": "./dist/extensions/effect.js",
        "default": "./dist/extensions/effect.js"
      },
      "./extensions/schema": {
        "types": "./dist/extensions/schema.d.ts",
        "import": "./dist/extensions/schema.js",
        "default": "./dist/extensions/schema.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/json-schema": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "effect": "^4.1.2"
  },
  "peerDependencies": {
    "effect": ">=4.0.0"
  }
}
