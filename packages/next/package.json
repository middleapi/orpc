{
  "name": "@orpc/next",
  "type": "module",
  "version": "2.0.0-beta.48",
  "description": "Next.js integration for oRPC: call typesafe procedures through Next.js Server Functions",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "homepage": "https://orpc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/next"
  },
  "keywords": [
    "orpc",
    "nextjs",
    "next",
    "server-functions",
    "server-actions",
    "react",
    "rpc",
    "typescript",
    "typesafe"
  ],
  "sideEffects": [
    "./dist/extensions/actionable.js"
  ],
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks/index.d.ts",
        "import": "./dist/hooks/index.js",
        "default": "./dist/hooks/index.js"
      },
      "./extensions/actionable": {
        "types": "./dist/extensions/actionable.d.ts",
        "import": "./dist/extensions/actionable.js",
        "default": "./dist/extensions/actionable.js"
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./extensions/actionable": "./src/extensions/actionable.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsc && node ../../scripts/verify-dist.ts"
  },
  "peerDependencies": {
    "next": ">=16.2.7",
    "react": ">=19.2.7"
  },
  "dependencies": {
    "@orpc/client": "workspace:*",
    "@orpc/openapi": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*"
  },
  "devDependencies": {
    "next": "^16.4.4",
    "react": "^19.3.1"
  }
}
