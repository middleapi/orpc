{
  "name": "@orpc/json-schema",
  "version": "2.0.0-beta.49",
  "description": "JSON Schema conversion and smart request coercion for oRPC and OpenAPI",
  "keywords": [
    "coercion",
    "json-schema",
    "openapi",
    "orpc",
    "typescript",
    "validation"
  ],
  "homepage": "https://orpc.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/middleapi/orpc.git",
    "directory": "packages/json-schema"
  },
  "funding": [
    "https://github.com/sponsors/dinwwwh",
    "https://opencollective.com/middleapi"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "prepack": "tsc"
  },
  "dependencies": {
    "@openapi-spec/types": "~0.7.1",
    "@orpc/client": "workspace:*",
    "@orpc/contract": "workspace:*",
    "@orpc/server": "workspace:*",
    "@orpc/shared": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
