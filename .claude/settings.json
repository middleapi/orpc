{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ./node_modules/.bin/oxfmt --no-error-on-unmatched-pattern \"$f\"; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Running oxfmt"
          }
        ]
      }
    ]
  }
}
