{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; ./node_modules/.bin/oxfmt --no-error-on-unmatched-pattern \"$f\"; ./node_modules/.bin/oxlint --fix \"$f\"; } >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Running oxfmt + oxlint --fix"
          }
        ]
      }
    ]
  }
}
